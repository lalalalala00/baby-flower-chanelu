{
  "name": "chanelu",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.5",
  "publisher": "lalalalala00",
  "repository": {
    "type": "git",
    "url": "https://github.com/lalalalala00/baby-flower-chanelu.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "chanelu.view",
          "name": "%view.name%",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "chanelu.toggleDesktop",
        "title": "%chanelu.toggleDesktop%",
        "category": "%category%"
      },
      {
        "command": "chanelu.pet",
        "title": "%chanelu.pet%",
        "category": "%category%"
      },
      {
        "command": "chanelu.sleep",
        "title": "%chanelu.sleep%",
        "category": "%category%"
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "chanelu.showOnDesktop": {
          "type": "boolean",
          "default": true,
          "description": "%chanelu.showOnDesktop%"
        },
        "chanelu.desktopSize": {
          "type": "number",
          "default": 96,
          "minimum": 40,
          "maximum": 300,
          "description": "%chanelu.desktopSize%"
        },
        "chanelu.size": {
          "type": "number",
          "default": 72,
          "minimum": 32,
          "maximum": 200,
          "description": "%chanelu.size%"
        },
        "chanelu.speed": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "maximum": 200,
          "description": "%chanelu.speed%"
        },
        "chanelu.sleepAfterSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "%chanelu.sleepAfterSeconds%"
        }
      }
    }
  },
  "keywords": [
    "pet",
    "dog",
    "desktop pet",
    "cute",
    "puppy",
    "강아지",
    "샤네루",
    "chanelu"
  ],
  "galleryBanner": {
    "color": "#FFF8E1",
    "theme": "light"
  },
  "homepage": "https://github.com/lalalalala00/baby-flower-chanelu",
  "bugs": {
    "url": "https://github.com/lalalalala00/baby-flower-chanelu/issues"
  },
  "scripts": {
    "package": "npx -y @vscode/vsce@3.2.1 package --baseContentUrl https://github.com/lalalalala00/baby-flower-chanelu/blob/main/ --baseImagesUrl https://raw.githubusercontent.com/lalalalala00/baby-flower-chanelu/main/"
  }
}
