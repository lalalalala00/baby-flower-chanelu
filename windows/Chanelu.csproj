<Project Sdk="Microsoft.NET.Sdk">

  <!-- 꽃개 샤네루 윈도우용 데스크톱 펫.
       .NET Framework 4.8(윈도우 10/11 기본 탑재)을 대상으로 해서 받는 사람이 런타임을 설치할 필요가 없어요.
       빌드: dotnet build windows/Chanelu.csproj -c Release  (윈도우에서, GitHub Actions가 대신 해줘요) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Chanelu</AssemblyName>
    <RootNamespace>Chanelu</RootNamespace>
    <ApplicationIcon>chanelu.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.7</Version>
    <Product>Baby Flower Chanelu</Product>
    <AssemblyTitle>Baby Flower Chanelu</AssemblyTitle>
    <Company>lalalalala00</Company>
    <Copyright>© 2026 lalalalala00. Chanelu artwork all rights reserved.</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\media\sheet.png" LogicalName="sheet.png" />
    <EmbeddedResource Include="chanelu.ico" LogicalName="chanelu.ico" />
  </ItemGroup>

</Project>
